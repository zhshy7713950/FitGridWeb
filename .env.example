# Public host name only; do not include a scheme or path.
DOMAIN=grid.example.com
APP_BASE_PATH=/fitgrid
# Local loopback port used by the existing nginx vhost.
APP_PORT=3300
# Existing public nginx HTTPS port. Use 443 for the standard URL.
PUBLIC_HTTPS_PORT=443
# Existing one-server nginx vhost selected by the installer.
NGINX_SITE=/etc/nginx/sites-available/grid.example.com.conf
# Leave empty for port 443; otherwise use a leading colon, for example :8443.
PUBLIC_PORT_SUFFIX=
BETTER_AUTH_URL=https://grid.example.com/fitgrid

# Pin an immutable release tag or sha256 digest. Never deploy :latest.
APP_IMAGE=ghcr.io/zhshy7713950/fitgridweb:sha-REPLACE_WITH_FULL_40_CHARACTER_COMMIT

POSTGRES_DB=fitgridweb
# Migration/database-owner login created by the official PostgreSQL image.
POSTGRES_USER=fitgrid_migrate
POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Restricted runtime login created only on the first database initialization.
APP_DATABASE_USER=fitgrid_app
APP_DATABASE_PASSWORD=REPLACE_WITH_A_DIFFERENT_32_CHAR_SECRET

DATABASE_URL=postgresql://fitgrid_app:APP_PASSWORD@db:5432/fitgridweb
MIGRATION_DATABASE_URL=postgresql://fitgrid_migrate:MIGRATION_PASSWORD@db:5432/fitgridweb
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OWNER_REF_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
# Optional; defaults to BETTER_AUTH_SECRET when omitted.
CURSOR_SIGNING_SECRET=
LOG_LEVEL=info

# Host-side backup paths. The encryption key must be chmod 600 and outside Git.
BACKUP_DIR=/var/lib/fitgridweb/backups
BACKUP_REMOTE_DIR=/mnt/fitgridweb-offsite
BACKUP_ENCRYPTION_KEY_FILE=/root/.config/fitgridweb/backup.key
BACKUP_RETENTION_DAYS=180

# Root-owned portable archives for administrator download and disaster recovery.
PORTABLE_BACKUP_DIR=/var/lib/fitgridweb/portable-backups
PORTABLE_BACKUP_HISTORY_FILE=/var/lib/fitgridweb/admin-ops/web/status/backups.json
ADMIN_OPS_DIR=/var/lib/fitgridweb/admin-ops/web
PORTABLE_BACKUP_MAX_BYTES=536870912
