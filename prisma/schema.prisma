generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  member
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum AlgorithmVersion {
  ANDROID_V2_1_0 @map("android-v2.1.0")

  @@map("algorithm_version")
}

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false) @map("email_verified")
  image           String?
  username        String?         @unique
  role            UserRole        @default(member)
  status          UserStatus      @default(active)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  invitationsMade Invitation[]    @relation("InvitationCreator")
  invitationsUsed Invitation[]    @relation("InvitationConsumer")
  gridTrades      GridTrade[]
  importPreviews  ImportPreview[]
  priceAlerts     PriceAlert[]
  alertEvents     PriceAlertEvent[]
  alertOutbox     PriceAlertOutbox[]
  alertChannel    PriceAlertChannel?

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  issuer                String
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.Char(64)
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy      User?     @relation("InvitationConsumer", fields: [usedById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("invitations")
}

model GridTrade {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String           @map("owner_id") @db.Uuid
  productCode       String           @map("product_code") @db.VarChar(64)
  productName       String?          @map("product_name") @db.VarChar(120)
  maxPrice          Decimal          @map("max_price") @db.Decimal(30, 10)
  minTradeQuantity  Decimal          @map("min_trade_quantity") @db.Decimal(30, 10)
  gearAmplitude     Decimal          @map("gear_amplitude") @db.Decimal(30, 10)
  perShare          Decimal          @map("per_share") @db.Decimal(30, 10)
  keepShare         Int              @map("keep_share")
  increaseAmplitude Int              @map("increase_amplitude")
  mediumAmplitude   Int?             @map("medium_amplitude")
  bigAmplitude      Int?             @map("big_amplitude")
  maxAmplitude      Int              @map("max_amplitude")
  isShort           Boolean          @map("is_short")
  category          String?          @db.VarChar(120)
  sortOrder         Int              @default(0) @map("sort_order")
  algorithmVersion  AlgorithmVersion @default(ANDROID_V2_1_0) @map("algorithm_version")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, productCode])
  @@index([ownerId, sortOrder, createdAt, id])
  @@index([ownerId, productCode])
  @@map("grid_trades")
}

model ImportPreview {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.Char(64)
  fileDigest  String    @map("file_digest") @db.Char(64)
  payload     Json
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
  @@map("import_previews")
}

model MarketInstrument {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String @unique @db.VarChar(32)
  name      String @db.VarChar(160)
  market    String @db.VarChar(2)
  currency  String @db.VarChar(3)
  kind      String @db.VarChar(5)
  tencent   String? @db.VarChar(32)
  yahoo     String? @db.VarChar(32)
  eastmoney String? @db.VarChar(40)
  quote     Json?
  createdAt DateTime @default(now()) @map("created_at")
  alerts    PriceAlert[]
  candles   MarketMinute[]
  bases     MarketDailyBasis[]
  @@map("market_instruments")
}

model MarketMinute {
  instrumentId String @map("instrument_id") @db.Uuid
  provider String @db.VarChar(12)
  start DateTime
  end DateTime
  open Decimal @db.Decimal(30, 10)
  high Decimal @db.Decimal(30, 10)
  low Decimal @db.Decimal(30, 10)
  close Decimal @db.Decimal(30, 10)
  fetchedAt DateTime @map("fetched_at")
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  @@id([instrumentId, provider, start])
  @@index([start])
  @@map("market_minutes")
}

model MarketDailyBasis {
  instrumentId String @map("instrument_id") @db.Uuid
  provider String @db.VarChar(12)
  sessionDate String @map("session_date") @db.VarChar(10)
  payload Json
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  @@id([instrumentId, provider, sessionDate])
  @@map("market_daily_bases")
}

model MarketScan {
  id String @id @db.VarChar(80)
  market String @db.VarChar(2)
  windowEnd DateTime @map("window_end")
  status String @db.VarChar(16)
  report Json
  createdAt DateTime @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")
  @@index([createdAt])
  @@map("market_scans")
}

model PriceAlert {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  instrumentId String @map("instrument_id") @db.Uuid
  condition Json
  enabled Boolean @default(false)
  version Int @default(1)
  armed Boolean @default(true)
  cursor DateTime?
  activeFrom DateTime @map("active_from")
  continuityDegraded Boolean @default(false) @map("continuity_degraded")
  lastError String? @map("last_error") @db.VarChar(240)
  lastSuccess DateTime? @map("last_success")
  lastEvaluation Json? @map("last_evaluation")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  events PriceAlertEvent[]
  outbox PriceAlertOutbox[]
  @@index([ownerId, enabled, deletedAt])
  @@map("price_alerts")
}

model PriceAlertChannel {
  ownerId String @id @map("owner_id") @db.Uuid
  keyCipher String @map("key_cipher")
  version Int @default(1)
  testedAt DateTime? @map("tested_at")
  lastError String? @map("last_error") @db.VarChar(240)
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@map("price_alert_channels")
}

model PriceAlertEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  version Int
  minuteStart DateTime @map("minute_start")
  minuteEnd DateTime @map("minute_end")
  price Decimal @db.Decimal(30, 10)
  threshold Decimal @db.Decimal(30, 10)
  ma Decimal? @db.Decimal(30, 10)
  provider String @db.VarChar(12)
  evidence Json
  outboxId String? @map("outbox_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rule PriceAlert @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@unique([ruleId, version, minuteStart])
  @@index([ownerId, createdAt])
  @@map("price_alert_events")
}

model PriceAlertOutbox {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  version Int
  channelVersion Int @map("channel_version")
  batchEnd DateTime @map("batch_end")
  payload Json
  status String @default("pending") @db.VarChar(12)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  expiresAt DateTime @map("expires_at")
  leaseUntil DateTime? @map("lease_until")
  lastError String? @map("last_error") @db.VarChar(240)
  acceptedAt DateTime? @map("accepted_at")
  createdAt DateTime @default(now()) @map("created_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rule PriceAlert @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@unique([ruleId, version, batchEnd])
  @@index([ownerId, status, nextAttemptAt])
  @@map("price_alert_outbox")
}

model ResearchSeries {
  key String @id @db.VarChar(160)
  definition Json
  cursor String? @db.VarChar(10)
  complete Boolean @default(false)
  checkedAt DateTime? @map("checked_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  retryAt DateTime? @map("retry_at")
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until")
  failures Int @default(0)
  error String? @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at")
  observations ResearchObservation[]
  @@map("research_series")
}

model ResearchObservation {
  seriesKey String @map("series_key") @db.VarChar(160)
  date String @db.VarChar(10)
  revision Int
  value Decimal? @db.Decimal(30,10)
  quality String @db.VarChar(16)
  contentHash String @map("content_hash") @db.Char(64)
  raw Json
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  sourcePublishedAt DateTime? @map("source_published_at")
  series ResearchSeries @relation(fields:[seriesKey], references:[key], onDelete:Restrict)
  @@id([seriesKey,date,revision])
  @@map("research_observations")
}
