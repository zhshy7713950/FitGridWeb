generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  member
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum AlgorithmVersion {
  ANDROID_V2_1_0 @map("android-v2.1.0")

  @@map("algorithm_version")
}

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String          @unique
  emailVerified   Boolean         @default(false) @map("email_verified")
  image           String?
  username        String?         @unique
  role            UserRole        @default(member)
  status          UserStatus      @default(active)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  invitationsMade Invitation[]    @relation("InvitationCreator")
  invitationsUsed Invitation[]    @relation("InvitationConsumer")
  gridTrades      GridTrade[]
  importPreviews  ImportPreview[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  issuer                String
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.Char(64)
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy      User?     @relation("InvitationConsumer", fields: [usedById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("invitations")
}

model GridTrade {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String           @map("owner_id") @db.Uuid
  productCode       String           @map("product_code") @db.VarChar(64)
  productName       String?          @map("product_name") @db.VarChar(120)
  maxPrice          Decimal          @map("max_price") @db.Decimal(30, 10)
  minTradeQuantity  Decimal          @map("min_trade_quantity") @db.Decimal(30, 10)
  gearAmplitude     Decimal          @map("gear_amplitude") @db.Decimal(30, 10)
  perShare          Decimal          @map("per_share") @db.Decimal(30, 10)
  keepShare         Int              @map("keep_share")
  increaseAmplitude Int              @map("increase_amplitude")
  mediumAmplitude   Int?             @map("medium_amplitude")
  bigAmplitude      Int?             @map("big_amplitude")
  maxAmplitude      Int              @map("max_amplitude")
  isShort           Boolean          @map("is_short")
  category          String?          @db.VarChar(120)
  sortOrder         Int              @default(0) @map("sort_order")
  algorithmVersion  AlgorithmVersion @default(ANDROID_V2_1_0) @map("algorithm_version")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([ownerId, productCode])
  @@index([ownerId, sortOrder, createdAt, id])
  @@index([ownerId, productCode])
  @@map("grid_trades")
}

model ImportPreview {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.Char(64)
  fileDigest  String    @map("file_digest") @db.Char(64)
  payload     Json
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiresAt])
  @@map("import_previews")
}
