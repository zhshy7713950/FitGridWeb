[Unit]
Description=Recover and guard FitGridWeb maintenance state before application boot
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service
Before=fitgridweb.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/fitgridweb
EnvironmentFile=/etc/fitgridweb/fitgridweb.env
RuntimeDirectory=fitgridweb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/opt/fitgridweb/ops/maintenance-worker.sh
UMask=0077
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
