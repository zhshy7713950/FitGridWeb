[Unit]
Description=Recover and guard FitGridWeb maintenance state before application boot
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service
Before=fitgridweb.service nginx.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/fitgridweb
EnvironmentFile=/etc/fitgridweb/fitgridweb.env
RuntimeDirectory=fitgridweb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/install -o root -g root -m 0644 /dev/null /run/fitgridweb/maintenance.flag
ExecStart=/opt/fitgridweb/ops/maintenance-worker.sh --recovery
UMask=0077
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
