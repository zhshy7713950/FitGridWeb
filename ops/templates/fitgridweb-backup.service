[Unit]
Description=FitGridWeb unattended off-host backup
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/fitgridweb
EnvironmentFile=/etc/fitgridweb/fitgridweb.env
ExecStart=/opt/fitgridweb/ops/backup.sh
UMask=0077
TimeoutStartSec=infinity
